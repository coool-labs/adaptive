{
  "name": "@coool/opencode-adaptive",
  "version": "1.6.0",
  "description": "Execution supervisor plugin for OpenCode v2: capability-tier routing, structured-evidence escalation, horizontal failure recovery, and resource health tracking.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coool-labs/adaptive.git",
    "directory": "packages/opencode"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./rpc": {
      "import": "./dist/rpc.js",
      "types": "./dist/rpc.d.ts"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsdown && vite build --config guiconfig.ts",
    "pack:check": "vite-node ../../scripts/pack-check.ts --pkg opencode",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm --prefix ../.. run check -- --pkg opencode",
    "verify": "npm --prefix ../.. run verify -- --pkg opencode",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e:runtime": "vitest run --config vitest.e2e.config.ts",
    "plugin-test": "opencode-plugin-test",
    "e2e:web": "playwright test",
    "e2e:gui": "vitest run --config test/e2e-gui/vitest.config.ts --coverage",
    "e2e:tui": "termwright test -- --config test/e2e-tui/vitest.config.ts",
    "traceability": "vite-node ../../scripts/traceability.ts --pkg opencode",
    "verify:release": "npm run verify"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.1 <3"
  },
  "dependencies": {
    "@opencode/schema": ">=2.2.1 <3",
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@coool/opencode-plugin-test": "github:Hacklone/opencode-plugin-test",
    "@opencode/plugin": "2.2.5",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@playwright/test": "^1.64.1",
    "jsdom": "^25.0.1",
    "solid-js": "^1.9.18",
    "termwright": "^0.7.7",
    "tsdown": "0.23.7",
    "vite": "^6.4.5",
    "vite-plugin-solid": "^2.11.15"
  }
}
