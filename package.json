{
  "name": "adaptive",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coool-labs/adaptive.git"
  },
  "workspaces": [
    "packages/opencode"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "coverage": "npm run coverage --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "lint:biome": "biome lint --error-on-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:release": "npm run verify:release --workspace @coool/opencode-adaptive"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "fast-check": "^4.10.2",
    "prettier": "^3",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vite-node": "^6.0.0",
    "vitest": "^4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
