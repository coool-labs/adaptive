{
  "name": "adaptive",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coool-labs/adaptive.git"
  },
  "workspaces": [
    "packages/core",
    "packages/testkit",
    "packages/opencode"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "coverage": "npm run coverage --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "lint:biome": "biome lint --error-on-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "vite-node scripts/run.ts check",
    "verify": "vite-node scripts/run.ts verify",
    "doctor": "vite-node scripts/doctor.ts",
    "pack:check": "npm run pack:check --workspaces --if-present",
    "plugin-test": "npm run plugin-test --workspaces --if-present",
    "e2e:runtime": "npm run e2e:runtime --workspaces --if-present",
    "e2e:gui": "npm run e2e:gui --workspaces --if-present",
    "e2e:web": "npm run e2e:web --workspaces --if-present",
    "e2e:tui": "npm run e2e:tui --workspaces --if-present",
    "traceability": "npm run traceability --workspaces --if-present",
    "test:tooling": "vitest run --config scripts/vitest.config.ts",
    "coverage:tooling": "vitest run --config scripts/vitest.config.ts --coverage",
    "typecheck:tooling": "tsc -p scripts/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "verify:release": "npm run verify -- --all"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@coool/adaptive-core": "0.0.0",
    "@coool/adaptive-testkit": "0.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "fast-check": "^4.10.2",
    "prettier": "^3",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vite-node": "^6.0.0",
    "vitest": "^4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
