{
  "name": "@coool/opencode-adaptive",
  "version": "0.1.0",
  "description": "Execution supervisor plugin for OpenCode v2: capability-tier routing, structured-evidence escalation, horizontal failure recovery, and resource health tracking.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./rpc": {
      "import": "./dist/rpc.js",
      "types": "./dist/rpc.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.1 <3"
  },
  "dependencies": {
    "@opencode/schema": ">=2.2.1 <3",
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@opencode/plugin": "2.2.5",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "fast-check": "^4.10.2",
    "prettier": "^3",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vitest": "^4"
  }
}
