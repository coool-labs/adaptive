{
  "name": "@coool/opencode-adaptive",
  "version": "1.4.1",
  "description": "Execution supervisor plugin for OpenCode v2: capability-tier routing, structured-evidence escalation, horizontal failure recovery, and resource health tracking.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coool-labs/opencode-adaptive.git"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./rpc": {
      "import": "./dist/rpc.js",
      "types": "./dist/rpc.d.ts"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json && vite build --config guiconfig.ts",
    "pack:check": "vite-node scripts/pack-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --project unit",
    "lint": "eslint .",
    "lint:biome": "biome lint --error-on-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "plugin-test": "opencode-plugin-test",
    "e2e:web": "playwright test",
    "e2e:gui": "vitest run --config test/e2e-gui/vitest.config.ts --coverage",
    "e2e:tui": "termwright test -- --config test/e2e-tui/vitest.config.ts",
    "traceability": "vite-node scripts/traceability.ts",
    "verify:release": "vite-node scripts/verify-release.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.1 <3"
  },
  "dependencies": {
    "@opencode/schema": ">=2.2.1 <3",
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@coool/opencode-plugin-test": "github:Hacklone/opencode-plugin-test",
    "@eslint/js": "^9.39.5",
    "@opencode/plugin": "2.2.5",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "fast-check": "^4.10.2",
    "jsdom": "^25.0.1",
    "prettier": "^3",
    "solid-js": "^1.9.18",
    "termwright": "^0.7.7",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vite": "^6.4.5",
    "vite-node": "^6.0.0",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
